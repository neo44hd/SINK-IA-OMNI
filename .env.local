# ═══════════════════════════════════════════════════════════════════════════════
# SYNK-OPS Zero-Cost Implementation
# Production .env file with 100% free-tier providers
# Cost: $0/month forever
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server Configuration ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL PROVIDERS (free, zero-cost, priority after cloud-free)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Ollama (Local AI Models) ──────────────────────────────────────────────────
# Container synk-ia-ollama @ host:11435 (no choca con synk-ia-backend:11434)
OLLAMA_URL=http://localhost:11435
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11435
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Other models available locally (lightweight only):
#   ollama pull qwen3:1.7b   (1.4GB, super-fast)
#   ollama pull qwen2.5:3b   (2.0GB, balanced)

# ── LM Studio (Local AI Models - PRIMARY) ────────────────────────────────────
# 7 modelos descargados (LM Studio app). Cero latencia, cero costo.
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Modelos LM Studio disponibles (modelos reales detectados 2026-09-18):
LMSTUDIO_CHAT_MODEL=prism-ml/bonsai-27b
LMSTUDIO_CODE_MODEL=deepseek-v4-flash
LMSTUDIO_VISION_MODEL=qwen/qwen3-vl-4b
LMSTUDIO_REASONING_MODEL=zai-org/glm-4.6v-flash
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_DEFAULT_MODEL=prism-ml/bonsai-27b

# ═══════════════════════════════════════════════════════════════════════════════
# FREE CLOUD API KEYS (Get these from websites below)
# ═══════════════════════════════════════════════════════════════════════════════

# ── OPENROUTER (REQUIRED - 50+ free models) ──────────────────────────────────
# How to get: https://openrouter.ai/
#   1. Sign up (no credit card needed)
#   2. Go to: https://openrouter.ai/keys
#   3. Copy your API key
#   4. Paste below
# Cost: $0/month (hundreds of free models)
#
OPENROUTER_API_KEY=PASTE_YOUR_KEY_HERE
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ── GOOGLE GEMINI (REQUIRED - Unlimited free) ────────────────────────────────
# How to get: https://makersuite.google.com/app/apikeys
#   1. Click "Create API Key"
#   2. Copy the key
#   3. Paste below
# Cost: $0/month forever (really unlimited)
#
GOOGLE_GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# ── OPENAI (OPTIONAL - has $5 free credit) ──────────────────────────────────
# How to get: https://openai.com/
#   1. Create account (get $5 credit automatically)
#   2. Go to: https://platform.openai.com/account/api-keys
#   3. Create API key
#   4. Paste below
# Cost: $0 (while credit lasts, ~2-3 months)
#
OPENAI_API_KEY=

# ── ANTHROPIC CLAUDE (OPTIONAL - 100k tokens free) ──────────────────────────
# How to get: https://claude.ai/
#   1. Sign up free
#   2. Get API key from console (if available)
# Cost: $0/month for 100k tokens
#
ANTHROPIC_API_KEY=

# ── GROQ (OPTIONAL - Super fast free) ────────────────────────────────────────
# How to get: https://console.groq.com/
# Cost: $0/month
#
GROQ_API_KEY=

# ── MISTRAL (OPTIONAL - Open models free) ────────────────────────────────────
# How to get: https://console.mistral.ai/
# Cost: $0/month
#
MISTRAL_API_KEY=

# ── NVIDIA (OPTIONAL - via OpenRouter mostly) ────────────────────────────────
# How to get: https://build.nvidia.com/
# Cost: $0/month
#
NVIDIA_API_KEY=

# ── HUGGINGFACE (OPTIONAL - serverless free) ────────────────────────────────
# How to get: https://huggingface.co/
# Cost: $0/month
#
HF_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# MODEL SELECTION (All these are FREE)
# ═══════════════════════════════════════════════════════════════════════════════

# Task-specific models (priority order: LM Studio primary, then Ollama, then cloud)
# ── Model selection: solo FREE + LOCAL (LM Studio primario, Ollama fallback, OpenRouter free)
CLASSIFY_MODEL=zai-org/glm-4.6v-flash
EXTRACT_MODEL=deepseek-v4-flash
VISION_MODEL=qwen/qwen3-vl-4b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
DEEP_MODEL=prism-ml/bonsai-27b
CHAT_MODEL=prism-ml/bonsai-27b
LIGHTWEIGHT_MODEL=llama3.2:3b
REASONING_MODEL=zai-org/glm-4.6v-flash

# Provider selection (LM Studio local primero, Ollama local segundo)
# Sin keys Gemini/NVIDIA/OpenAI: sólo free+local
CLASSIFY_PROVIDER=lmstudio
EXTRACT_PROVIDER=lmstudio
DEEP_PROVIDER=lmstudio
CHAT_PROVIDER=lmstudio
HERMES_PROVIDER=lmstudio
OPCODE_PROVIDER=lmstudio
VISION_PROVIDER=lmstudio
EMBEDDING_PROVIDER=lmstudio
LIGHTWEIGHT_PROVIDER=ollama
REASONING_PROVIDER=lmstudio

# Free cloud fallback (cuando local saturado)
CLOUD_FREE_PROVIDER=openrouter
CLOUD_FREE_MODEL=inclusionai/ling-3.0-flash:free

# ── Generation Settings ──────────────────────────────────────────────────────
NUM_CTX=8192
NUM_PREDICT=2048
TEMPERATURE=0.1

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=synk-ops-zero-cost-2026
ADMIN_TOKEN=sinkia2026

# ── Markitdown (Python) ──────────────────────────────────────────────────────
MARKITDOWN_EXE=/opt/markitdown-venv/bin/python
MARKITDOWN_WRAPPER=/Users/davidnows/synkia/repos/synk-ia/server/tools/markitdown_wrapper.py

# ── Directories ──────────────────────────────────────────────────────────────
# Local macOS paths (override via .env.docker or .env.production on server)
UPLOADS_DIR=/Users/davidnows/synkia/repos/synk-ia/uploads
DATA_DIR=/Users/davidnows/synkia/repos/synk-ia/data

# ── Email / Notifications (All FREE) ─────────────────────────────────────────
# SendGrid: 100 emails/day free
# Mailgun: 10k emails/month free
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Telegram (Optional, free) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Internal URLs ────────────────────────────────────────────────────────────
SINKIA_API_URL=http://localhost:9301
BACKEND_URL=http://localhost:3001

# ── Tailscale (Optional) ─────────────────────────────────────────────────────
DISABLE_TAILSCALE_AUTH=false
TAILSCALE_ALLOW_LOCAL=true

# ═══════════════════════════════════════════════════════════════════════════════
# IMPLEMENTATION CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════════
#
# ✅ Step 1: Get your free API keys
#    [ ] OpenRouter: https://openrouter.ai/keys → Copy key
#    [ ] Gemini: https://makersuite.google.com/app/apikeys → Copy key
#    [ ] (Optional) OpenAI: https://platform.openai.com/account/api-keys
#
# ✅ Step 2: Fill in the keys above
#    [ ] OPENROUTER_API_KEY=sk_or_...
#    [ ] GEMINI_API_KEY=AIza...
#    [ ] OPENAI_API_KEY= (optional, leave blank if no credit)
#
# ✅ Step 3: Start Ollama
#    [ ] Run: ollama serve
#    [ ] In another terminal: ollama pull llama3.2:3b
#    [ ] In another terminal: ollama pull qwen2.5-coder:7b
#
# ✅ Step 4: Replace the main .env file
#    [ ] cp /Users/davidnows/synkia/repos/synk-ia/.env.zero-cost \
#           /Users/davidnows/synkia/repos/synk-ia/.env
#
# ✅ Step 5: Start your services
#    [ ] docker-compose up -d
#    [ ] OR: npm start
#    [ ] OR: pm2 start ecosystem.config.js
#
# ✅ Step 6: Verify it works
#    [ ] curl http://localhost:11434/api/tags
#    [ ] curl http://localhost:3001/api/health
#    [ ] Check cost report (should be $0.00)
#
# ═══════════════════════════════════════════════════════════════════════════════
# COST GUARANTEE
# ═══════════════════════════════════════════════════════════════════════════════
# This configuration uses ONLY free-tier providers
# You will NEVER be charged a subscription fee with this setup
# Worst case: Your API keys need to be replaced (but still free)
# ═══════════════════════════════════════════════════════════════════════════════
# ── Hub unificado: OmniRoute (synk-orchestrator + synk-model-selector) ──────────
# Sesiones pueden consultar el orquestrador para auto-selección de modelo
ORCHESTRATOR_URL=http://127.0.0.1:9500
OMNIROUTE_URL=http://127.0.0.1:9501
# Legacy alias (no usar) — OmniRoute en stack nuevo:
HUB_URL=http://127.0.0.1:9500
